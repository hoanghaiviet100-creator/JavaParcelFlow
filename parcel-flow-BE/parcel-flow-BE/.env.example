# Backend environment (Spring Boot). All have safe local defaults in application.yml;
# override in production. Loaded via the process environment / docker-compose.

# Database
DB_URL=jdbc:mysql://localhost:3307/parcel_flow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=admin123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Mail (SMTP). MAIL_ENABLED=false just logs a notice instead of sending.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@parcelflow.local

# Security — CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-parcel-flow-super-secret-key-please-override-0123456789
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bootstrap admin (disable in production once real admins exist)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@parcelflow.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
